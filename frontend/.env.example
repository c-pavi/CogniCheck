# Copy to .env.local (dev) or set in Vercel project settings (production).

# Base URL for API calls. Leave unset for local dev — Vite will proxy /api
# to the backend at localhost:8000 (see vite.config.ts).
# In production, set this to the deployed FastAPI URL, e.g.:
#   VITE_API_URL=https://cognicheck-backend.onrender.com
# (no trailing /api: the app adds that itself)
VITE_API_URL=
