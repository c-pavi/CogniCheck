# Copy to .env and adjust for your environment.

# Postgres connection string.
#
# macOS + Homebrew:  postgresql://<your-macos-username>@localhost:5432/cognicheck
#                    (Homebrew creates a user matching your macOS username with no password.
#                     Run `whoami` in a terminal to see your username.)
# Docker / other:    postgresql://postgres:postgres@localhost:5432/cognicheck
# On Render:         use the "Internal Database URL" from your Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognicheck

# Where uploaded audio files are stored on the backend disk.
# On Render free tier, this directory is ephemeral (wiped on redeploy).
AUDIO_STORAGE_PATH=./audio_storage

# Comma-separated list of allowed CORS origins.
# Local dev: http://localhost:5173
# Production: your deployed frontend URL, e.g. https://cognicheck.vercel.app
CORS_ORIGINS=http://localhost:5173

# Consent text version. Bump this string whenever the consent copy changes;
# every session records the version accepted for audit purposes.
CONSENT_VERSION=demo-v1

# Password for the researcher dashboard (/admin in the frontend), which shows
# participant data and audio. Leave empty to turn the dashboard API off.
# Use a long random value, e.g. from: openssl rand -base64 24
ADMIN_TOKEN=
